# ---------------------------------------------------------------------------
# SIH26006 - Intelligent Freight Forecasting & Vessel Chartering DSS
# ---------------------------------------------------------------------------
# NOTE: data/ is intentionally NOT ignored. It holds synthetic / demo
# freight datasets that are meant to be version-controlled (see README).

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Environment / secret files (keep the template)
.env
.env.*
!.env.example

# Local database (auto-created on first run by services/data_service.py)
*.db
*.sqlite
*.sqlite3

# Trained model artifacts (regenerated by the ML pipeline; keep the folder)
models/*.joblib
models/*.pkl
models/*.h5
models/*.onnx
!models/.gitkeep

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Editors / IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Build / distribution
build/
dist/
*.spec

# Downloaded installers / large local binaries
*.exe
*.msi
*.zip
*.7z
